/*
 * ==============================================================================
 *  Saccharomyces Genomics Pipeline 
 * ==============================================================================
 *  Architecture: Fully config-driven, universal Sensu Stricto pipeline
 *  Standard: nf-core compliant (Strict separation of Hardware/Software)
 * ==============================================================================
 */

manifest {
    name            = 'saccharomyces-genomics-pipeline'
    author          = 'Yeast Genomics Lab'
    description     = 'WGS variant calling pipeline for Saccharomyces species'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.1.8'
}

// ========================================================================
// 1. GLOBAL PIPELINE PARAMETERS
// ========================================================================
params {
    // --- Input / Output ---
    samplesheet              = 'samplesheet.csv'                            // Path to samplesheet.csv (required)
    outdir                   = 'results_v6'                                 // Output directory

    // --- Module 1: Data Acquisition & SRA Toolkit Parameters ---
    max_Retries              = 5                                            // Network download retries (ENA & NCBI)
    min_r2_len               = 30                                           // Min avg read length (bp) to keep PE status
    ncbi_dir                 = '~/.ncbi'                                    // SRA Toolkit config path (cluster-safe, no $HOME)
    aria2c_min_split_size    = '1M'                                         // Minimum chunk size for parallel ENA downloads
    aria2c_connect_timeout   = 30                                           // Max seconds to wait for initial ENA connection
    aria2c_timeout           = 60                                           // Max seconds to wait if ENA download stalls
    aria2c_max_tries         = 3                                            // Number of times to retry a failed ENA connection
    aria2c_retry_wait        = 10                                           // Seconds to pause between retries to avoid IP ban
    prefetch_timeout         = 3600                                         // Max seconds (1 hr) allowed for NCBI fallback download
    prefetch_max_size        = '50G'                                        // Max file size limit to protect local hard drive
    fasterq_timeout          = 1800                                         // Max seconds (30 min) allowed for SRA to FASTQ extraction
    sra_max_forks            = 4                                            // Number of accessions to download simultaneously
    aria2c_connections       = 16                                           // Connections per file to bypass ENA throttling

    // --- Module 2: Read Filtration (fastp) ---
    adapter_fasta            = null                                         // Custom adapter FASTA (optional, fastp auto-detects)
    trim_front1              = 0                                            // Trim bases from front of R1 (Off)
    trim_tail1               = 0                                            // Trim bases from tail of R1 (Off)
    trim_front2              = 0                                            // Trim bases from front of R2 (Off)
    trim_tail2               = 0                                            // Trim bases from tail of R2 (Off)
    min_read_length          = 30                                           // Discard reads shorter than 30bp
    qualified_quality        = 20                                           // Enforce Q20 quality threshold
    cut_mean_quality         = 20                                           // Enforce Q20 sliding window mean

    // --- Module 3 & 4: Mapping & Coverage Profiling ---
    reference                = 'data/references/cer_eub/cer_eub_reference.fasta' // Local FASTA path
    genome_id                = null                                         // NCBI Assembly accession
    save_reference           = false                                        // Publish indexed reference to outdir?
    min_mapping_pct          = 0                                            // Mapping rate threshold
    run_coverage             = true                                         // Toggle Module 4 ON (true) or OFF (false)
    genome_file              = 'data/slidingwindow/cer_eub_genomefile.tab'  // Genome chrom size file
    sliding_windows          = 'data/slidingwindow/cer_eub_slidingwindows.bed' // Sliding windows BED file

    // --- Module 5 & 6: Haplotype Calling & Joint Genotyping ---
    ploidy                   = 2                                            // Default nuclear ploidy
    include_extrachromosomal = false                                        // Set to false to strictly call only nuclear chromosomes
    ploidy_map               = [ 'M': 1, 'P': 1 ]                           // Suffix (M, P) -> Ploidy (1). Rest defaults to params.ploidy
    batch_size               = 50                                           // Prevents GenomicsDBImport from consuming too much RAM
    genomicsdb_update_path   = 'results_v5/Joint_Genotyping'                // Point to an existing DB path to incrementally update
    merge_strategy           = 'separate'                                   // 'separate' (subgenome) or 'together' (all chromosomes combined)
    extrachromosomal_strategy= 'bundled'                                    // 'bundled' (all in one) or 'isolated' (splits nuclear/mito/plasmid)
    
    // Universal Sensu Stricto Dictionary
    species_map = [
        'c': 'cerevisiae', 'e': 'eubayanus',    'p': 'paradoxus',  'm': 'mikatae',
        'k': 'kudriavzevii', 'u': 'uvarum',       'a': 'arboricola', 'j': 'jurei'
    ]
    
    // --- Module 7: Variant Filtration & Quality Control ---
    keep_snp_vcf             = true                                         // Save the SNPs-only filtered VCF?
    keep_indel_vcf           = true                                         // Save the INDELs-only left-aligned VCF?
    keep_merged_vcf          = true                                         // Save the final recombined (SNP+INDEL) VCF?
    downstream_vcf           = 'merged'                                     // Target for Module 8: 'snps', 'indels', or 'merged'
    repetitive_intervals     = 'data/repititive_intervals/sensustricto8.repetitive.intervals' // Telomeres/Ty elements to ignore

    // GATK Best Practices SNP Hard-Filtering Thresholds
    snp_qd_filter            = 'QD < 5.0'                                   // QualByDepth: Normalizes quality by depth to catch fake variants
    snp_qual_filter          = 'QUAL < 30.0'                                // Overall Phred-scaled confidence
    snp_sor_filter           = 'SOR > 3.0'                                  // StrandOddsRatio: Checks for strand bias
    snp_fs_filter            = 'FS > 60.0'                                  // FisherStrand: Phred-scaled p-value for strand bias
    snp_mq_filter            = 'MQ < 40.0'                                  // MappingQuality: Drops poor supporting reads
    snp_mqranksum_filter     = 'MQRankSum < -12.5'                          // MQRankSum: Checks if mutant reads map worse than reference
    snp_readpos_filter       = 'ReadPosRankSum < -8.0'                      // ReadPosRankSum: Flags mutations only at read ends

    // GATK Best Practices INDEL Hard-Filtering Thresholds
    indel_qd_filter          = 'QD < 5.0'                                   // INDEL QualByDepth threshold
    indel_qual_filter        = 'QUAL < 30.0'                                // INDEL overall quality threshold
    indel_fs_filter          = 'FS > 60.0'                                  // INDEL FisherStrand bias threshold
    indel_readpos_filter     = 'ReadPosRankSum < -20.0'                     // INDEL ReadPosRankSum threshold

    // --- Module 8, 9, 10: IBSx Phylogeny & Evolutionary Trees ---
    run_phylogeny            = true                                         // Enable or disable the generation of phylogenetic trees?
    keep_allele_tables       = true                                         // Save the intermediate allele1/allele2 .tsv matrices?
    ibs_strategy             = 'chromosomal'                                // 'chromosomal' (16 separate trees + 1 combined) or 'combined'
    filter_monomorphic       = true                                         // Drop uninformative sites (identical alleles)?
    ibs_block_rows           = 8192                                         // Chunk size for C++ binary matrix processing (RAM tuning)
    ibs_report_blocks        = 5                                            // How often C++ OpenMP threads report progress
    
}

// ========================================================================
// 2. HARDWARE & SOFTWARE DEFINITIONS (nf-core standard)
// ========================================================================
process {
    
    // --- A. HARDWARE LABELS (Strictly Resource Allocation) ---
    withLabel: 'tiny'      { cpus = 1; memory = 2.GB }
    withLabel: 'base'      { cpus = 2; memory = 4.GB }
    withLabel: 'low'       { cpus = 4; memory = 8.GB }
    withLabel: 'medium'    { cpus = 4; memory = 8.GB }
    withLabel: 'high'      { cpus = 4; memory = 8.GB; time = 12.h }
    withLabel: 'calling'   { cpus = 2; memory = 6.GB; time = 4.h }
    withLabel: 'phylogeny' { cpus = 4; memory = 8.GB }

    // Concurrency Controls
    withName: 'FETCH_SRA'         { maxForks = params.sra_max_forks; errorStrategy = 'retry'; maxRetries = params.max_Retries }
    withName: 'HAPLOTYPE_CALLER'  { maxForks = 2 }
    withName: 'GENOMICSDB_IMPORT' { maxForks = 2 }
    withName: 'GENOTYPE_GVCFS'    { maxForks = 2 }

    // --- B. SOFTWARE TARGETING (Strictly Tool Management) ---

    // Module 1: SRA Tools & Network Utilities
    withName: 'FETCH_SRA' {
    conda     = 'conda-forge::aria2 conda-forge::curl conda-forge::pigz bioconda::sra-tools'
    container = 'hanzala014/sacgenomics-sra-download:1.0.0'
    }

    // Python & Bash Scripts
    withName: 'FETCH_REFERENCE|CLASSIFY_RUN|INGEST_LOCAL|WRITE_RUN_QC|CREATE_STRAIN_LIST|WRITE_STRAIN_QC|WRITE_FILTER_SUMMARY|WRITE_MAPPING_SUMMARY|MERGE_PE|MERGE_SE' {
    conda     = 'conda-forge::python=3.11'
    container = 'quay.io/biocontainers/python:3.11'
    }

    // Module 2: Read Filtration
    withName: 'FILTER_PE|FILTER_SE' {
    conda     = 'bioconda::fastp=1.3.6'
    container = 'quay.io/biocontainers/fastp:1.3.6--h43da1c4_0'
    }

    // Module 3: Mapping
    withName: 'BWA_INDEX|MAP_PE|MAP_SE' {
    conda     = 'bioconda::bwa=0.7.17 bioconda::samtools=1.16.1'
    container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:219b6c272b25e7e642ae3ff0bf0c5c81a5135ab4-0'
    }   

    withName: 'MARKDUP|MAPPING_STATS' {
    conda     = 'bioconda::samtools=1.16.1'
    container = 'quay.io/biocontainers/samtools:1.16.1--h6899075_1'
    }

    // Module 4: Coverage
    withName: 'COMPUTE_COVERAGE' {
    conda     = 'bioconda::bedtools=2.31.1'
    container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
    }

    // Module 5, 6, 7: GATK
    withName: 'PREPARE_GATK_REF|HAPLOTYPE_CALLER|GATHER_STRAIN_GVCFS|GENOMICSDB_IMPORT|GENOTYPE_GVCFS|MERGE_VCFS|FILTER_SNPS|FILTER_INDELS|MERGE_AND_CLEAN' {
    conda     = 'bioconda::samtools=1.16.1 bioconda::gatk4=4.4.0.0'
    container = 'broadinstitute/gatk:4.4.0.0'
    }

    // Module 8: BCFtools
    withName: 'PREP_ALLELES' {
    conda     = 'bioconda::bcftools=1.19'
    container = 'quay.io/biocontainers/bcftools:1.19--h8b25389_0'
    }

    // Module 9: C++ Matrix Generator
    withName: 'RUN_IBS' {
    conda     = 'conda-forge::r-base=4.3.1 conda-forge::r-tidyverse conda-forge::r-rcpp conda-forge::cxx-compiler'
    container = 'rocker/tidyverse:4.3.1'
    }

    // Module 10: R Phylogenetics
    withName: 'BUILD_TREE' {
    conda     = 'conda-forge::r-base=4.3.1 conda-forge::r-tidyverse conda-forge::r-ape conda-forge::r-phangorn'
    container = 'quay.io/biocontainers/r-phangorn:2.4.0--r351h9d2a408_0'
    }
}

// ========================================================================
// 3. EXECUTION PROFILES
// ========================================================================

profiles {
    conda {
        conda.enabled = true
    }

    docker {
    docker.enabled = true
    docker.runOptions = '-u $(id -u):$(id -g)'
    }

    wave {
        wave.enabled  = true
        wave.strategy  = ['conda']
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    test {
        params { outdir = 'test_results' }
        process {
            withLabel: 'low'       { cpus = 2; memory = 4.GB }
            withLabel: 'medium'    { cpus = 2; memory = 4.GB }
            withLabel: 'high'      { cpus = 2; memory = 4.GB; maxForks = 1 }
            withLabel: 'calling'   { cpus = 2; memory = 4.GB; maxForks = 1 }
            withLabel: 'phylogeny' { cpus = 2; memory = 4.GB }
        }
    }
}

// ========================================================================
// 4. REPORTING & METRICS
// ========================================================================
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/Pipeline_Info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/Pipeline_Info/execution_timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/Pipeline_Info/pipeline_dag.html"
}