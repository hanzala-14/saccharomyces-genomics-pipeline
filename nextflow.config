/*
 * Saccharomyces Genomics Pipeline — nextflow.config
 * --------------------------------------------------
 * Covers Modules 1 (download/QC), 2 (filtration), and 3 (mapping)
 */

// ========================================================================
// Pipeline Parameters
// ========================================================================
params {
    // --- Input / Output ---
    samplesheet       = 'samplesheet.csv'        // Path to samplesheet.csv (required)
    outdir            = 'results'                // Output directory

    // --- Module 1: Data Acquisition ---
    max_Retries        = 5                       // Network download retries (ENA & NCBI)
    min_r2_len         = 30                      // Min avg read length (bp)
    
    // --- Network & Bandwidth Tuning ---
    sra_max_forks      = 4                       // Number of accessions to download simultaneously (maxForks)
    aria2c_connections = 16                      // Connections per file to bypass ENA throttling (-x and -s)

// --- Module 2: Read Filtration (fastp) ---
    adapter_fasta     = null                     // Custom adapter FASTA (optional, fastp auto-detects)
    trim_front1       = 0                        // Off
    trim_tail1        = 0                        // Off
    trim_front2       = 0                        // Off
    trim_tail2        = 0                        // Off
    min_read_length   = 30                       // Discard reads shorter than 30bp
    qualified_quality = 20                       // Enforce Q20 quality threshold
    cut_mean_quality  = 20                       // Enforce Q20 sliding window mean

    // --- Module 3: Mapping ---
    reference         = 'data/references/cer_eub/cer_eub_reference.fasta' // Local FASTA path
    genome_id         = null                     // NCBI Assembly accession
    save_reference    = false                    // Publish indexed reference to outdir?
    min_mapping_pct   = 0                        // Mapping rate threshold

    // --- Module 4: Coverage Profiling (Optional) ---
    run_coverage      = true                    // Toggle Module 4 ON (true) or OFF (false)
    genome_file       = 'data/slidingwindow/cer_eub_genomefile.tab' // Genome chrom size file
    sliding_windows   = 'data/slidingwindow/cer_eub_slidingwindows.bed' // Sliding windows BED file
}

// ========================================================================
// Process Labels → Resource Allocation
// ========================================================================
process {
    withLabel: 'tiny' {
        cpus   = 1
        memory = 2.GB
    }
    withLabel: 'base' {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: 'low' {
        cpus   = 4
        memory = 8.GB
    }
    withLabel: 'medium' {
        cpus   = 4
        memory = 10.GB      
    }
    withName: 'FETCH_SRA' {
        maxForks      = params.sra_max_forks     // Controlled by params block now
        time          = 30.m   
        errorStrategy = 'retry'
        maxRetries    = params.max_Retries       // Controlled by params block now
    }
}

// ========================================================================
// Profiles: Conda (local dev) and Container (server/cloud)
// ========================================================================
profiles {

    /// --- LOCAL DEVELOPMENT: conda ---
    conda {
        conda.enabled = true
        process {
            withLabel: 'base' {
                // ADDED aria2 to ensure the new download strategy works
                conda = 'conda-forge::aria2 conda-forge::curl conda-forge::pigz bioconda::sra-tools'
            }
            withLabel: 'tiny' {
                conda = 'conda-forge::python>=3.9'
            }
            withLabel: 'low' {
                // ADDED bioconda::bedtools here so Module 4 works locally via Conda!
                conda = 'bioconda::bwa=0.7.19 bioconda::samtools=1.24 bioconda::bedtools=2.31.1'
            }
            withLabel: 'medium' {
                conda = 'bioconda::bwa=0.7.19 bioconda::samtools=1.24 bioconda::picard=3.5.0'
            }
        }
    }

    // --- PRODUCTION: Docker/Singularity containers ---
    docker {
        docker.enabled = true
        process {
            withLabel: 'base' {
                container = 'quay.io/biocontainers/mulled-v2-1fa26d1ce03c295fe2fdcf85831a92fbcbd7e8c2:59cdd445419f14abac76b31dd0d71571c401571f-0'
            }
            withLabel: 'tiny' {
                container = 'quay.io/biocontainers/python:3.11'
            }
            withLabel: 'low' {
                container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:7b14aa0aa06934a4ccf70b3c8a8dba9a37bdc89a-0'
            }
            withLabel: 'medium' {
                container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:7b14aa0aa06934a4ccf70b3c8a8dba9a37bdc89a-0'
            }
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process {
            withLabel: 'base' {
                container = 'https://depot.galaxyproject.org/singularity/mulled-v2-1fa26d1ce03c295fe2fdcf85831a92fbcbd7e8c2:59cdd445419f14abac76b31dd0d71571c401571f-0'
            }
            withLabel: 'tiny' {
                container = 'https://depot.galaxyproject.org/singularity/python:3.11'
            }
            withLabel: 'low' {
                container = 'https://depot.galaxyproject.org/singularity/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:7b14aa0aa06934a4ccf70b3c8a8dba9a37bdc89a-0'
            }
            withLabel: 'medium' {
                container = 'https://depot.galaxyproject.org/singularity/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:7b14aa0aa06934a4ccf70b3c8a8dba9a37bdc89a-0'
            }
        }
    }

    // --- Testing with minimal resources ---
    test {
        params {
            outdir = 'test_results'
        }
        process {
            withLabel: 'low' {
                cpus   = 2
                memory = 4.GB
            }
            withLabel: 'medium' {
                cpus   = 2
                memory = 4.GB
            }
        }
    }
}

// ========================================================================
// Global Execution Settings
// ========================================================================
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

// ========================================================================
// Manifest
// ========================================================================
manifest {
    name            = 'saccharomyces-genomics-pipeline'
    author          = 'Yeast Genomics Lab'
    description     = 'WGS variant calling pipeline for Saccharomyces species'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.1.3'
}